{{#each @docTree as |leaf|}}
  {{#if leaf.value}}
    {{#if leaf.link}}
      <button
        class="docs-nav-link docs-nav-level-{{@level}}"
        type="button"
        {{on "click" (fn @clickHandler leaf.value)}}
      >{{leaf.name}}</button>
    {{else}}
      <div class="docs-nav-section docs-nav-level-{{@level}}">{{leaf.name}}</div>
    {{/if}}
    <MenuItems @docTree={{leaf.value}} @level={{this.nextLevel}} @clickHandler={{@clickHandler}}/>
  {{/if}}
{{/each}}
