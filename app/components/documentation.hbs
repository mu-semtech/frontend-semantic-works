<div class="sw-page-header">
  <div class="sw-page-header-inner">
    <span class="sw-page-header-eyebrow">semantic·works</span>
    <h1>Documentation</h1>
    <p>Explore the framework, services, templates, and tools.</p>
  </div>
</div>

<div class="docs-layout">
  <aside class="docs-sidebar">
    <MenuItems @docTree={{@docTree}} @level={{0}} @clickHandler={{this.changeDoc}} @activeUrl={{this.currentUrl}}/>
  </aside>
  <main class="docs-content">
    {{this.currentDoc}}
  </main>
</div>